{
  "name": "@inft/auth-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:docs": "tsc -p tsconfig.docs.json",
    "docs": "pnpm build:docs && mkdir -p docs && api-extractor run --local && generate-split-documentation"
  },
  "dependencies": {
    "@inft/shared": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@inft/scripts": "workspace:*",
    "@microsoft/api-extractor": "^7.47.0",
    "@types/react": "^18.3.9",
    "tsup": "^8.3.5",
    "typescript": "^5.5.4"
  }
}
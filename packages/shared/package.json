{
  "name": "@inftkr/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:docs": "tsc -p tsconfig.docs.json",
    "docs": "pnpm build:docs && mkdir -p docs && api-extractor run --local && generate-split-documentation"
  },
  "devDependencies": {
    "@inftkr/scripts": "workspace:*",
    "@microsoft/api-extractor": "^7.47.0",
    "tsup": "^8.3.5",
    "typescript": "^5.5.4"
  }
}
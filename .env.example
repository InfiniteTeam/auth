# Infiniteteam Internal Auth System - Environment Configuration
# Copy this file to .env and fill in the values

# Domain configuration
DOMAIN=inft.kr
DOMAIN_PORTAL=id.inft.kr
DOMAIN_AUTH=auth.inft.kr

# PostgreSQL
POSTGRES_PASSWORD=<REPLACE_WITH_32_CHAR_RANDOM>

# Kratos secrets
KRATOS_COOKIE_SECRET=<REPLACE_WITH_32_CHAR_RANDOM>
KRATOS_CIPHER_SECRET=<REPLACE_WITH_32_CHAR_RANDOM>

# Hydra secrets
HYDRA_SYSTEM_SECRET=<REPLACE_WITH_32_CHAR_RANDOM>
PORTAL_COOKIE_SECRET=<REPLACE_WITH_32_CHAR_RANDOM>

# OAuth: GitHub
GITHUB_CLIENT_ID=<from_github_oauth_app>
GITHUB_CLIENT_SECRET=<from_github_oauth_app>

# OAuth: Discord
DISCORD_CLIENT_ID=<from_discord_oauth_app>
DISCORD_CLIENT_SECRET=<from_discord_oauth_app>
DISCORD_BOT_TOKEN=<from_discord_bot>
DISCORD_GUILD_ID=<target_discord_server_id>

# SMTP (for verification/recovery emails)
# From address is fixed to noreply@${DOMAIN} (noreply@inft.kr) in compose.yaml
SMTP_CONNECTION_URI=smtps://user:password@smtp.inft.kr:465?skip_ssl_verify=false

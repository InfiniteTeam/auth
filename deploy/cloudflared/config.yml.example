# Cloudflare Tunnel ingress map — TEMPLATE.
#
# This file is a template. At runtime cloudflared reads the generated
# `config.yml` (gitignored), which setup.sh creates by filling in the
# placeholders below from deploy/.env. Do NOT commit generated config.yml.
#
# Required .env values: TUNNEL_ID, AUTH_DOMAIN, ROOT_DOMAIN

tunnel: __TUNNEL_ID__
credentials-file: /etc/cloudflared/credentials.json

# Route map:
#   ${AUTH_DOMAIN}/oauth2/*, /auth*, /interaction*, /token*, /userinfo*,
#     /session*, /.well-known/*, /api/*  -> backend (OIDC/API)
#   ${ROOT_DOMAIN}/.well-known/webfinger -> backend
#   ${AUTH_DOMAIN}/*                     -> www (frontend portal)
#
# Order matters: cloudflared uses the first matching rule.
ingress:
  # OIDC / API / WebFinger on the auth domain -> backend
  - hostname: __AUTH_DOMAIN__
    path: /auth*
    service: http://backend:3000
  - hostname: __AUTH_DOMAIN__
    path: /interaction*
    service: http://backend:3000
  - hostname: __AUTH_DOMAIN__
    path: /token*
    service: http://backend:3000
  - hostname: __AUTH_DOMAIN__
    path: /userinfo*
    service: http://backend:3000
  - hostname: __AUTH_DOMAIN__
    path: /session*
    service: http://backend:3000
  - hostname: __AUTH_DOMAIN__
    path: /oauth2*
    service: http://backend:3000
  - hostname: __AUTH_DOMAIN__
    path: /.well-known*
    service: http://backend:3000
  - hostname: __AUTH_DOMAIN__
    path: /api*
    service: http://backend:3000

  # WebFinger on the root domain -> backend
  - hostname: __ROOT_DOMAIN__
    path: /.well-known/webfinger
    service: http://backend:3000

  # Frontend portal (catch-all for the auth domain) -> www
  - hostname: __AUTH_DOMAIN__
    service: http://www:3001

  # Catch-all rule (required)
  - service: http_status:404
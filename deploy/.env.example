# ========================================================
# inft-auth deployment environment
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ========================================================

# ---------------- Domains ----------------
# Auth server domain (OIDC issuer, frontend)
# e.g. auth.example.com
AUTH_DOMAIN=auth.example.com

# WebFinger (root) domain
# e.g. example.com
ROOT_DOMAIN=example.com

# ---------------- PostgreSQL ----------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=postgres

# auth DB (used by backend)
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=CHANGE_ME_AUTH_DB_PASSWORD
AUTH_DB_NAME=auth

# lldap DB (used by lldap)
LLDAP_DB_USER=lldap
LLDAP_DB_PASSWORD=CHANGE_ME_LLDAP_DB_PASSWORD
LLDAP_DB_NAME=lldap

# ---------------- lldap ----------------
# lldap admin account.
# The username maps to lldap's LLDAP_LDAP_USER_DN, the password to
# LLDAP_LDAP_USER_PASS. The email maps to LLDAP_LDAP_USER_EMAIL and is set on
# the admin account at bootstrap — backend LDAP login resolves users by email,
# so it must be a valid address. All three are only used on first run;
# backend LLDAP_ADMIN_DN/LLDAP_ADMIN_PASSWORD must match.
LLDAP_ADMIN_USERNAME=admin
LLDAP_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
LLDAP_ADMIN_EMAIL=admin@example.com

# LDAP base DN components (dc=<LLDAP_BASE_DC>,dc=<LLDAP_BASE_DOMAIN>)
LLDAP_BASE_DC=inft
LLDAP_BASE_DOMAIN=kr

# lldap JWT signing secret (use a random string)
LLDAP_JWT_SECRET=CHANGE_ME_JWT_SECRET

# lldap group whose members receive every platform permission
ADMIN_GROUP_NAME=admins

# ---------------- backend ----------------
# OIDC / session signing secret (strong random string)
SESSION_SECRET=CHANGE_ME_SESSION_SECRET

# Tailscale custom OIDC client secret (first consumer service)
TAILSCALE_CLIENT_SECRET=CHANGE_ME_TAILSCALE_CLIENT_SECRET

# Snowflake ID generator worker id (0-1023)
SNOWFLAKE_WORKER_ID=0

# ---------------- Social sign-in ------------
# GitHub OAuth app: https://github.com/settings/applications/new
# Authorization callback URL:
#   https://<AUTH_DOMAIN>/api/v1/auth/social/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub organization the member must belong to (membership gate).
# Only the user's ACTIVE memberships are checked.
GITHUB_ORG=

# Discord OAuth2 application: https://discord.com/developers/applications
# Redirect URI:
#   https://<AUTH_DOMAIN>/api/v1/auth/social/discord/callback
# PKCE is enforced for Discord (no client secret in the authorization URL).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord server (guild) and roles whose members may sign in via Discord.
DISCORD_GUILD_ID=
DISCORD_ROLE_IDS=

# Base URL used to build the sign-up verification email and the verification
# link. Defaults to ISSUER_URL; set it explicitly only if the callback API and
# the frontend are served from different origins.
SOCIAL_REDIRECT_BASE_URL=

# ---------------- Email verification (sign-up) ----------------
# SMTP used to send the 6-digit verification code email on social sign-up.
# Omit the whole block to disable email verification (social sign-up then
# fails with "verification_unavailable" at runtime).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Verification code / link TTLs and code attempt limit (ms / count).
OAUTH_STATE_TTL_MS=600000
VERIFY_CODE_TTL_MS=600000
VERIFY_TOKEN_TTL_MS=86400000
VERIFY_MAX_ATTEMPTS=5

# ---------------- Cloudflare Tunnel (optional) ----------------
# Inft-auth runs cloudflared in locally-managed mode: routing is defined in
# deploy/cloudflared/config.yml, and cloudflared authenticates with
# deploy/cloudflared/credentials.json (derived from the token once, then
# gitignored). TUNNEL_TOKEN is only needed to generate that credentials file.
#
# How to get the token (one of):
#   1. Dashboard — Networking > Tunnels > <select tunnel> > Overview tab >
#      "Add a replica" → copy the install command and extract the eyJ... value.
#   2. API        — GET /accounts/{ACCOUNT_ID}/cfd_tunnel/{TUNNEL_ID}/token
#   3. Creation   — the response of tunnel creation includes `id` and `token`.
#
# TUNNEL_ID is the tunnel UUID, used for the DNS CNAME record
# (<TUNNEL_ID>.cfargotunnel.com) and issued to the token API.
TUNNEL_TOKEN=
TUNNEL_ID=

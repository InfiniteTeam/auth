es/oidc-17","page_id":"/docs/guides/oidc","tags":[],"type":"text","url":"/docs/guides/oidc#authorization-flow","content":"The consumer verifies the `id_token` against the JWKS (RS256 / ES256) and\nfetches the **userinfo** endpoint when profile claims are needed."},"192":{"id":"/docs/guides/oidc-18","page_id":"/docs/guides/oidc","tags":[],"type":"text","url":"/docs/guides/oidc#tailscale-custom-oidc-client","content":"The first consuming service is **Tailscale** (custom OIDC)."},"193":{"id":"/docs/guides/oidc-19","page_id":"/docs/guides/oidc","tags":[],"type":"text","url":"/docs/guides/oidc#tailscale-custom-oidc-client","content":"Setting"},"194":{"id":"/docs/guides/oidc-20","page_id":"/docs/guides/oidc","tags":[],"type":"text","url":"/docs/guides/oidc#tailscale-custom-oidc-client","content":"Value"},"195":{"id":"/docs/guides/oidc-21","page_id":"/docs/guides/oidc","tags":[],"type":"text","url":"/docs/guides/oidc#tailscale-custom-oidc-client","content":"Redirect URI"},"196":{"id":"/docs/guides/oidc-22","page_id":"/docs/guides/oidc","tags":[],"type":"text","url":"/docs/guides/oidc#tailscale-custom-oidc-client","content":"`https://login.tailscale.com/a/oauth_response`"},"197":{"id":"/docs/guides/oidc-23","page_id":"/docs/guides/oidc","tags":[],"type":"text","url":"/docs/guides/oidc#tailscale-custom-oidc-client","content":"Scopes"},"198":{"id":"/docs/guides/oidc-24","page_id":"/docs/guides/oidc","tags":[],"type":"text","url":"/docs/guides/oidc#tailscale-custom-oidc-client","content":"`openid profile email`"},"199":{"id":"/docs/guides/oidc-25","page_id":"/docs/guides/oidc","tags":[],"type":"text","url":"/docs/guides/oidc#tailscale-custom-oidc-client","content":"Tailscale is configured in its admin console with the issuer\n`https://auth.inft.kr`. The client credentials are seeded into the backend and\nrecorded in `TAILSCALE_CLIENT_SECRET`."},"200":{"id":"/docs/guides/oidc-26","page_id":"/docs/guides/oidc","tags":[],"type":"text","url":"/docs/guides/oidc#consumer-sdk--inftkr
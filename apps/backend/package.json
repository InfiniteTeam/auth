{
  "name": "@inftkr/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "inft-auth OIDC/OAuth2 provider and session API (Nest.js + oidc-provider)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "docs": "echo \"@inftkr/backend is an app and has no public API docs\""
  },
  "dependencies": {
    "@discordjs/core": "^2.6.0",
    "@discordjs/rest": "^2.6.3",
    "@inftkr/auth-core": "workspace:*",
    "@inftkr/shared": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@octokit/oauth-app": "^8.0.4",
    "@octokit/rest": "^22.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "discord-api-types": "^0.38.55",
    "dotenv": "^17.4.2",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.1",
    "oidc-provider": "^9.12.2",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@inftkr/scripts": "workspace:*",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.6",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^8.0.1",
    "@types/oidc-provider": "^9.12.0",
    "@types/pg": "^8.15.0",
    "tsup": "^8.3.5",
    "typescript": "^5.5.4",
    "vitest": "^5.0.0"
  }

// Prisma schema for the inft-auth `auth` database.
//
// This database is owned by the backend and stores OAuth/OIDC runtime state
// (clients, grants, tokens) and the platform session records. User identity
// lives in the separate `lldap` database, which is owned by lldap itself and
// never written to from here.

generator client {
  provider             = "prisma-client"
  output               = "../src/generated/prisma"
  moduleFormat         = "esm"
  importFileExtension  = "js"
}

datasource db {
  provider = "postgresql"
  // url is configured in prisma.config.ts (Prisma ORM v7).
}

// A registered OAuth 2.0 / OIDC client, backed by the oidc-provider Client
// adapter. Static clients (e.g. the Tailscale custom client) are seeded.
model OidcClient {
  clientId      String   @id
  clientSecret  String?
  grantTypes    String[] @default([])
  responseTypes String[] @default([])
  redirectUris  String[] @default([])
  scopes        String[] @default([])
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Generic persistence for oidc-provider runtime models (AccessToken,
// RefreshToken, AuthorizationCode, Interaction, Grant, etc.). Each row maps to
// a single oidc-provider model instance identified by our adapter's `name` +
// `id`.
model OidcModel {
  model     String
  id        String
  payload   Json
  grantId   String?
  expiresAt DateTime?

  @@id([model, id])
  @@index([grantId])
  @@index([model, expiresAt])
}

// An authenticated session referenced by the `inft_session` cookie. The cookie
// carries only the session id plus a signature; the profile lives here so it
// can be revoked server-side.
model Session {
  id          String   @id
  userId      String
  provider    String
  email       String
  name        String
  roles       String[] @default([])
  permissions String   @default("0")
  issuedAt    DateTime @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  @@index([userId])
}

// A social identity (GitHub / Discord) linked to a local user account.
//
// `verified` reflects the ephemeral email verification completed at signup;
// once true, the account is an accepted sign-in path. Email verification
// artifacts (the magic code and the magic link token) are stored only as
// SHA-256 hashes so the raw secrets never touch the database.
model Account {
  id                        String    @id
  // lldap uid of the linked local account.
  userId                    String
  // Social provider: `github` or `discord`.
  provider                  String
  // User id as reported by the provider.
  providerUserId            String
  // Email reported by the provider (used as the new uid for fresh signups).
  email                     String
  // Display name taken from the provider profile.
  name                      String?
  // Avatar image URL from the provider.
  avatarUrl                 String?
  // Whether the signup email verification succeeded.
  verified                  Boolean   @default(false)
  // SHA-256 hash of the 6-digit signup verification code.
  verificationCodeHash      String?
  verificationCodeExpires   DateTime?
  // SHA-256 hash of the one-time verification link token.
  verificationTokenHash     String?
  verificationTokenExpires  DateTime?
  // Consecutive wrong-code attempts (bounded by VERIFY_MAX_ATTEMPTS).
  verificationAttempts      Int       @default(0)
  verifiedAt                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerUserId])
  @@index([userId])
}

// Platform-level settings. Values are seeded from environment variables at
// bootstrap and can be overridden at runtime through the admin API (the server
// settings screen). `value` is a JSON document whose shape is specific to each
// `key`; a `null` value means "fall back to the environment default".
model PlatformSetting {
  key       String    @id
  value     Json?
  updatedAt DateTime  @updatedAt
  updatedBy String?

  @@index([updatedAt])
}

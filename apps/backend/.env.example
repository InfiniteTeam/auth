# inft-auth backend environment example
# Copy to .env and fill in real values.

# HTTP
PORT=3000
NODE_ENV=development

# Public issuer URL advertised in the OIDC discovery document.
# In development the issuer must match the URL the server actually listens on.
ISSUER_URL=http://localhost:3000

# OIDC signing keys are generated once and persisted to this file.
OIDC_JWKS_PATH=./jwks.json
SESSION_SECRET=change-me-please

# Client secret for the seeded Tailscale custom OIDC client.
TAILSCALE_CLIENT_SECRET=

# PostgreSQL for the auth database (Prisma).
DATABASE_URL=postgresql://auth:auth@localhost:5432/auth

# lldap connection + a backend service account used to make GraphQL queries.
LLDAP_URL=http://localhost:17170
LLDAP_ADMIN_DN=admin
LLDAP_ADMIN_PASSWORD=change-me
